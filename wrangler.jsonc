{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manga-sync-cloudflare",
  "main": "worker.js",
  "compatibility_date": "2026-08-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "MANGA_ROOMS",
        "class_name": "MangaRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MangaRoom"]
    }
  ]
}
